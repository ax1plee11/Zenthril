## Zenthril client environment template
# Copy this file to `client/.env` for local development.
# Do not commit real client `.env` files.

# Backend API origin without a trailing slash.
# Local development can leave this empty; the client will use the current host
# and port 8080 for the backend.
#
# Example:
# VITE_API_BASE=https://api.example.com
VITE_API_BASE=

# Optional GIF provider keys. Leave empty to disable external GIF search.
VITE_TENOR_KEY=
VITE_GIPHY_KEY=

# Security escape hatch for research-only web builds.
# Production web builds do not store E2EE private keys in localStorage unless
# this is explicitly set to true. Keep false for public deployments.
VITE_ALLOW_INSECURE_KEY_STORAGE=false
