# Zenthril environment template
# Copy to .env for local development. Never commit real .env files.
#
# Secret generation:
#   JWT_SECRET=$(openssl rand -hex 64)
#   METRICS_TOKEN=$(openssl rand -hex 32)
#   OPERATIONAL_TOKEN=$(openssl rand -hex 32)
#   POSTGRES_PASSWORD=$(openssl rand -hex 32)
#
# Production rules:
# - Set ENVIRONMENT=production.
# - Replace every change-me value.
# - Use exact HTTPS origins only. Do not include paths, queries, or wildcards.
# - Keep PostgreSQL and Redis private; do not expose them directly to the internet.

# Runtime
APP_ENV=development
ENVIRONMENT=development
SERVICE_NAME=zenthril-api
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL
POSTGRES_USER=zenthril
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
POSTGRES_DB=zenthril
DB_URL=postgres://zenthril:change-me-use-openssl-rand-hex-32@localhost:5432/zenthril?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_URLS=

# JWT and sessions
# Access/refresh TTLs are configurable and enforced by backend auth config.
# Refresh tokens are stored, rotated, replay-detected, and revoked through Redis.
JWT_SECRET=change-me-use-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# HTTP and WebSocket origin policy
# Development may use localhost origins. Production must use exact HTTPS origins.
# Examples: https://app.example.com,https://zenthril.example.com
# Invalid examples: *, https://app.example.com/path, https://*.example.com
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173

# Metrics
# Required in production. Send as: Authorization: Bearer <token>
METRICS_TOKEN=change-me-use-openssl-rand-hex-32
# Required in production for /health, /healthz, /readyz and gateway stats probes.
OPERATIONAL_TOKEN=change-me-use-openssl-rand-hex-32

# Federation
# Alpha feature. Keep disabled unless you are testing signed server-to-server flows.
FEDERATION_ENABLED=false
# Required when FEDERATION_ENABLED=true. Send as: Authorization: Bearer <token>
FEDERATION_TOKEN=change-me-use-openssl-rand-hex-32

# TLS
# Prefer terminating TLS at Caddy/Traefik/Nginx in production.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Federation
NODE_DOMAIN=localhost
NODE_PRIVATE_KEY=

# Administration
ADMIN_USER_IDS=
MODERATOR_IDS=

# Event bus
# Supported today: memory, kafka/redpanda in next-gen internal event layer.
EVENT_BUS_DRIVER=memory
KAFKA_BROKERS=localhost:9092
NATS_URL=
EVENT_CONSUMER_GROUP=zenthril-api

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=zenthril-api

# Future distributed storage
SCYLLA_HOSTS=
SCYLLA_KEYSPACE=zenthril_messages

# S3-compatible media storage
S3_ENDPOINT=
S3_BUCKET=zenthril-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# WebSocket gateway
# Legacy hub also enforces a 64 KiB per-message limit and per-connection rate limit.
GATEWAY_MAX_CONNECTIONS=50000
GATEWAY_READ_LIMIT_BYTES=1048576
GATEWAY_WRITE_TIMEOUT=10s
GATEWAY_PONG_WAIT=60s
GATEWAY_PING_PERIOD=45s
GATEWAY_DRAIN_TIMEOUT=30s

# Client connectivity resilience / multi-server settings
# Public client builds can also ship client/public/servers.json.
# VITE_SERVER_LIST accepts JSON array of API origins, for example:
#   ["https://api1.example.com","https://backup.example.net"]
# The client derives ws/wss origins from these API origins and can fall back
# across configured servers when network requests fail.
VITE_API_BASE=http://localhost:8080
VITE_SERVER_LIST=
# Optional remote server-list bootstrap. Browser clients cannot override DNS
# resolution directly, so DoH is used only to discover alternate server-list URLs.
VITE_SERVER_LIST_URL=
VITE_SERVER_LIST_DOH_NAME=
VITE_SERVER_LIST_DOH_TEMPLATE=
VITE_DOH_ENDPOINT=https://cloudflare-dns.com/dns-query
# Experimental JSON padding for transport measurement. This does not replace E2EE or TLS.
VITE_WS_PADDING=
VITE_CONNECTIVITY_MODE=off
# WebRTC privacy. Production client builds default to relay-only ICE to reduce
# IP leakage. Configure TURN servers before enabling production voice/P2P.
# Set false only for controlled development where direct STUN/P2P is acceptable.
VITE_WEBRTC_RELAY_ONLY=
