# ─────────────────────────────────────────────────────────────────────────────
# Zenthril — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# Values: development | production
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string.
DB_URL=postgres://zenthril:zenthril@localhost:5432/zenthril?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required. Must be at least 32 characters. Use a random string in production.
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_minimum_32_chars

# ── HTTP Server ───────────────────────────────────────────────────────────────
HTTP_ADDR=:8080

# ── TLS (optional, recommended in production) ─────────────────────────────────
# TLS_CERT_FILE=/etc/ssl/certs/zenthril.crt
# TLS_KEY_FILE=/etc/ssl/private/zenthril.key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Empty = allow all (development only). Set explicitly in production.
# Example: https://app.zenthril.com,https://zenthril.com
CORS_ALLOWED_ORIGINS=

# ── WebSocket Origins ─────────────────────────────────────────────────────────
# Comma-separated. Empty = same as CORS_ALLOWED_ORIGINS.
WS_ALLOWED_ORIGINS=

# ── Metrics Security ──────────────────────────────────────────────────────────
# Token required to access /metrics and /metrics/prometheus in production.
# Empty = open in development, required in production.
# Generate: openssl rand -hex 24
METRICS_TOKEN=

# ── Federation ────────────────────────────────────────────────────────────────
NODE_DOMAIN=localhost
# NODE_PRIVATE_KEY=

# ── Moderators ────────────────────────────────────────────────────────────────
# Comma-separated UUIDs of platform moderator accounts.
# MODERATOR_IDS=
