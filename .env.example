POSTGRES_USER=zenthril
POSTGRES_PASSWORD=change-me-in-production-use-long-random-string
POSTGRES_DB=zenthril

# База данных PostgreSQL
DB_URL=postgres://zenthril:change-me-in-production-use-long-random-string@localhost:5432/zenthril?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string

# Сервер
HTTP_ADDR=:8080
TLS_CERT_FILE=
TLS_KEY_FILE=

# CORS (пусто = разрешить любой origin — только для dev). Прод: https://app.example.com
# CORS_ALLOWED_ORIGINS=

# WebSocket Origin (пусто = как CORS). Прод: тот же origin, что у веб-клиента
# WS_ALLOWED_ORIGINS=

# Админы (UUID пользователей): только они могут делать глобальный бан/разбан и другие admin-операции
# ADMIN_USER_IDS=

# Федерация
NODE_DOMAIN=localhost
NODE_PRIVATE_KEY=

# Next-gen runtime
APP_ENV=development
SERVICE_NAME=zenthril-api
NODE_ID=local-api-1
PUBLIC_BASE_URL=http://localhost:8080
GATEWAY_PUBLIC_ADDR=:8080
GATEWAY_MAX_CONNECTIONS=50000
GATEWAY_READ_LIMIT_BYTES=1048576
GATEWAY_WRITE_TIMEOUT=10s
GATEWAY_PONG_WAIT=60s
GATEWAY_PING_PERIOD=45s
GATEWAY_DRAIN_TIMEOUT=30s

# Comma-separated: shard-a=postgres://user:pass@host:5432/db?sslmode=require,shard-b=...
POSTGRES_SHARDS=
SHARD_VIRTUAL_NODES=128

# memory | kafka | nats
EVENT_BUS_DRIVER=memory
KAFKA_BROKERS=redpanda:9092
NATS_URL=
EVENT_CONSUMER_GROUP=zenthril-api

REDIS_CLUSTER_URLS=
SCYLLA_HOSTS=scylla:9042
SCYLLA_KEYSPACE=zenthril_messages

S3_ENDPOINT=
S3_BUCKET=zenthril-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

VAULT_ADDR=
OTEL_EXPORTER_OTLP_ENDPOINT=
