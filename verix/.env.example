# VERIX Knowledge Base — переменные окружения
# Скопировать в .env для локальной разработки. Nunca коммитить реальные .env.

# Neo4j (доступ только из backend по Docker-сети; порты 7474/7687 только на loopback)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-use-openssl-rand-hex-32
NEO4J_DATABASE=neo4j

# FastAPI KB Gateway
KB_GATEWAY_ADDR=:8090
KB_GATEWAY_TOKEN=change-me-use-openssl-rand-hex-32
KB_ADMIN_TOKEN=change-me-use-openssl-rand-hex-32
KB_CACHE_TTL=5m

# ETL
ETL_RUN_MODE=manual
ETL_BATCH_SIZE=100
ETL_SCHEMA_VER=verix.ingest.v1
